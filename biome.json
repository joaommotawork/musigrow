{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!biome/plugins/fixtures",
			"!.yarn",
			"!apps/musigrow-strapi/.cache",
			"!apps/musigrow-strapi/build"
		]
	},
	"formatter": {
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"plugins": [
		"./biome/plugins/import-no-anonymous-default-export.grit",
		"./biome/plugins/next-no-assign-module-variable.grit",
		"./biome/plugins/next-no-css-tags.grit",
		"./biome/plugins/next-no-duplicate-head.grit",
		"./biome/plugins/next-no-script-component-in-head.grit",
		"./biome/plugins/next-no-styled-jsx-in-document.grit",
		"./biome/plugins/next-no-title-in-document-head.grit",
		"./biome/plugins/react-display-name.grit",
		"./biome/plugins/react-no-deprecated.grit",
		"./biome/plugins/react-no-find-dom-node.grit",
		"./biome/plugins/react-no-is-mounted.grit",
		"./biome/plugins/react-no-unescaped-entities.grit",
		"./biome/plugins/react-require-render-return.grit",
		"./biome/plugins/sonarjs-max-switch-cases.grit",
		"./biome/plugins/sonarjs-no-collection-size-mischeck.grit",
		"./biome/plugins/sonarjs-no-duplicated-branches.grit",
		"./biome/plugins/sonarjs-no-element-overwrite.grit",
		"./biome/plugins/sonarjs-no-identical-expressions.grit",
		"./biome/plugins/sonarjs-no-one-iteration-loop.grit",
		"./biome/plugins/sonarjs-no-redundant-boolean.grit",
		"./biome/plugins/sonarjs-no-redundant-jump.grit",
		"./biome/plugins/sonarjs-no-small-switch.grit",
		"./biome/plugins/sonarjs-non-existent-operator.grit",
		"./biome/plugins/sonarjs-prefer-immediate-return.grit",
		"./biome/plugins/sonarjs-prefer-object-literal.grit",
		"./biome/plugins/sonarjs-prefer-single-boolean-return.grit"
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"a11y": {
				"noAccessKey": "error",
				"noAriaUnsupportedElements": "error",
				"noAutofocus": "error",
				"noDistractingElements": "error",
				"noHeaderScope": "error",
				"noInteractiveElementToNoninteractiveRole": "error",
				"noLabelWithoutControl": "error",
				"noNoninteractiveElementInteractions": "error",
				"noNoninteractiveElementToInteractiveRole": "error",
				"noNoninteractiveTabindex": "error",
				"noPositiveTabindex": "error",
				"noRedundantAlt": "error",
				"noRedundantRoles": "error",
				"noStaticElementInteractions": "error",
				"useAltText": "error",
				"useAnchorContent": "error",
				"useAriaActivedescendantWithTabindex": "error",
				"useAriaPropsForRole": "error",
				"useAriaPropsSupportedByRole": "error",
				"useFocusableInteractive": "error",
				"useHeadingContent": "error",
				"useHtmlLang": "error",
				"useIframeTitle": "error",
				"useKeyWithClickEvents": "error",
				"useKeyWithMouseEvents": "error",
				"useMediaCaption": "error",
				"useValidAnchor": "warn",
				"useValidAriaProps": "error",
				"useValidAriaRole": "error",
				"useValidAriaValues": "error",
				"useValidAutocomplete": "error"
			},
			"complexity": {
				"noBannedTypes": "error",
				"noExcessiveCognitiveComplexity": "error",
				"noImplicitCoercions": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"noVoid": "error",
				"useWhile": "error",
				"noUselessCatch": "error",
				"noUselessTernary": "error",
				"noUselessContinue": "error"
			},
			"correctness": {
				"noBeforeInteractiveScriptOutsideDocument": "warn",
				"noChildrenProp": "error",
				"noPrecisionLoss": "error",
				"noRenderReturnValue": "error",
				"noUnusedVariables": {
					"level": "error",
					"options": {
						"ignoreRestSiblings": false,
						"ignoreUsingDeclarations": false
					}
				},
				"useExhaustiveDependencies": "error",
				"useHookAtTopLevel": "error",
				"useInlineScriptId": "error",
				"useJsxKeyInIterable": "error"
			},
			"nursery": {
				"noDanglingUnderscore": "error",
				"noNestedSwitch": "error",
				"noNestedTemplateLiterals": "error",
				"noReactDirectStateMutation": "error",
				"useConsistentUnicodeBom": "off",
				"useControlLabel": "off",
				"useNextScriptForGoogleAnalytics": "warn"
			},
			"performance": {
				"noImgElement": "warn",
				"noSyncScripts": "error",
				"noUnwantedPolyfillio": "warn",
				"useGoogleFontPreconnect": "warn"
			},
			"security": {
				"noBlankTarget": "error",
				"noDangerouslySetInnerHtmlWithChildren": "error"
			},
			"style": {
				"noCommonJs": "error",
				"noHeadElement": "warn",
				"noInferrableTypes": "warn",
				"noNamespace": "error",
				"noNestedTernary": "error",
				"noNonNullAssertion": "warn",
				"noParameterAssign": "warn",
				"useArrayLiterals": "error",
				"useAsConstAssertion": "error",
				"useBlockStatements": "off",
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "generic"
					}
				},
				"useConsistentMemberAccessibility": {
					"level": "error",
					"options": {
						"accessibility": "explicit"
					}
				},
				"useConsistentTypeDefinitions": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"requireAscii": false
					}
				},
				"useReadonlyClassProperties": "error",
				"useCollapsedIf": "error"
			},
			"suspicious": {
				"noCommentText": "error",
				"noConstantBinaryExpressions": "error",
				"noDocumentImportInPage": "error",
				"noDuplicateJsxProps": "error",
				"noEmptyBlockStatements": "error",
				"noEmptyInterface": "error",
				"noExplicitAny": "warn",
				"noExtraNonNullAssertion": "error",
				"noHeadImportInDocument": "error",
				"noMisleadingInstantiator": "error",
				"noNonNullAssertedOptionalChain": "error",
				"noReactStringRefs": "error",
				"noTsIgnore": "error",
				"noUnknownAttribute": "error",
				"useAdjacentOverloadSignatures": "error",
				"useGoogleFontDisplay": "warn",
				"useNamespaceKeyword": "error",
				"noDuplicateElseIf": "error",
				"noSelfCompare": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"**/*.config.js",
				"**/*.cjs",
				"packages/tailwind-config/**",
				"commitlint.config.js",
				"apps/musigrow-strapi/**",
				"**/.storybook/*.js",
				"**/jest.setup.js"
			],
			"linter": {
				"rules": {
					"style": {
						"noCommonJs": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/musigrow-strapi/**"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"includes": ["*.ts", "*.tsx", "*.mts", "*.cts"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "error"
					},
					"correctness": {
						"noConstAssign": "off",
						"noGlobalObjectCalls": "off",
						"noInvalidBuiltinInstantiation": "off",
						"noInvalidConstructorSuper": "off",
						"noSetterReturn": "off",
						"noUndeclaredVariables": "off",
						"noUnreachable": "off",
						"noUnreachableSuper": "off",
						"useValidTypeof": "off"
					},
					"style": {
						"useConst": "error",
						"useSpreadOverApply": "error"
					},
					"suspicious": {
						"noDuplicateClassMembers": "off",
						"noDuplicateObjectKeys": "off",
						"noDuplicateParameters": "off",
						"noFunctionAssign": "off",
						"noImportAssign": "off",
						"noRedeclare": "off",
						"noUnsafeNegation": "off",
						"noVar": "error",
						"useGetterReturn": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.stories.*"],
			"plugins": [
				"./biome/plugins/storybook-await-interactions.grit",
				"./biome/plugins/storybook-context-in-play-function.grit",
				"./biome/plugins/storybook-default-exports.grit",
				"./biome/plugins/storybook-hierarchy-separator.grit",
				"./biome/plugins/storybook-prefer-pascal-case.grit",
				"./biome/plugins/storybook-story-exports.grit",
				"./biome/plugins/storybook-use-storybook-expect.grit",
				"./biome/plugins/storybook-use-storybook-testing-library.grit"
			]
		},
		{
			"includes": [
				"**/cypress/e2e/1-getting-started/**",
				"**/cypress/e2e/2-advanced-examples/**"
			],
			"linter": {
				"enabled": false
			}
		}
	]
}
